# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# JWT & Security (Ensure SECRET_KEY is replaced in production)
SECRET_KEY=change_this_to_a_secure_random_hex_string_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite)
DATABASE_PATH=backend/codebuffet.db

# Seed Account Configuration for Local/Hackathon Development
# (Passphrases used ONLY if database is newly initialized)
