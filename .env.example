# ==============================================================================
# CampusIQ - Environment Variables Template
# ==============================================================================
# Copy this file to backend/.env and frontend/.env or set variables accordingly.
# Do NOT commit actual secrets or sensitive credentials.

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# MongoDB Connection String
# If omitted or MongoDB is unreachable, CampusIQ gracefully activates
# synthetic data fallback mode using local synthetic dataset.
MONGODB_URI=mongodb://localhost:27017/campusiq

# Client Origins for CORS (comma-separated list for dev origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Google Gemini AI Configuration
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=
# Optional model override (defaults to gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Configurable API base URL consumed by Vite frontend
VITE_API_URL=http://localhost:5001/api
