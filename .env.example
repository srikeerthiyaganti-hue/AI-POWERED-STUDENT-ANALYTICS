# ==============================================================================
# VFSTR ACADEMIC DATA PIPELINE CONFIGURATION
# Copy to .env and customize for local or production deployments.
# ==============================================================================

# Database Connection (SQLite local path or PostgreSQL URI)
# Example SQLite: sqlite:///vignan_academic.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/vignan_academic
DATABASE_URL=sqlite:///vignan_academic.db

# Administrator API secret key for triggering data harvesting
PIPELINE_ADMIN_KEY=your-secure-admin-secret-key-change-in-production

# HTTP crawler configuration
USER_AGENT="VignanAcademicBot/1.0 (+https://omega-nine-tau.vercel.app; AI Student Success Platform)"
REQUEST_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_SIZE_BYTES=26214400
RATE_LIMIT_DELAY_SECONDS=1.0

# Server execution
HOST=0.0.0.0
PORT=8000
