# ==============================================================================
# CODEBUFFET — Environment Configuration Template
# Student Success Intelligence Platform (Copy to .env for local deployment)
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# JWT & Cryptographic Security (MANDATORY: Generate a 64-char hex string in production)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_64_char_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite)
DATABASE_PATH=backend/codebuffet.db

# Seed Account Configuration for Local Development Only
DEFAULT_ADMIN_EMAIL=admin@codebuffet.edu
DEFAULT_ADMIN_PASSWORD=replace_with_secure_admin_password
DEFAULT_MENTOR_EMAIL=rajesh.kumar@codebuffet.edu
DEFAULT_MENTOR_PASSWORD=replace_with_secure_mentor_password
DEFAULT_TPO_EMAIL=vikram.tpo@codebuffet.edu
DEFAULT_TPO_PASSWORD=replace_with_secure_tpo_password
DEFAULT_STUDENT_EMAIL=aarav.sharma@codebuffet.edu
DEFAULT_STUDENT_PASSWORD=replace_with_secure_student_password
