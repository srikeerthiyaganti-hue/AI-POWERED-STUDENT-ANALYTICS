# Backend Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String
# Leave as is or empty to run in synthetic data fallback mode
MONGODB_URI=mongodb://localhost:27017/campusiq

# Client Origin for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Google Gemini AI Configuration
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=
# Optional model override (defaults to gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest